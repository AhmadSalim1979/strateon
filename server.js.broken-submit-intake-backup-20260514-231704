async function createHubSpotContact(data) {
  if (!hubspotcreds.accessToken) {
    console.log('[' + new Date().toISOString() + '] HubSpot: no access token configured, skipping CRM');
    return;
  }
  // Map form fields to HubSpot standard properties
  const nameParts = (data.name || '').trim().split(' ');
  const firstname = nameParts[0] || '';
  const lastname = nameParts.slice(1).join(' ') || '';
  const properties = {
    email: data.email,
    firstname: firstname,
    lastname: lastname,
    company: data.company,
    phone: data.phone || '',
    // HubSpot built-in properties for audit data
    jobtitle: data.challenge || '',
    // Map as a note property — free tier notes are supported
    // Additional context stored as a custom note below
  };
  try {
    const result = await hubspotClient.crm.contacts.basicApi.create({ properties });
    // Add a note with additional audit fields
    if (result && result.body && result.body.id) {
      const noteBody = `Pipeline Leak Audit\nIndustry: ${data.industry || 'N/A'}\nLeads/month: ${data.leads_per_month || 'N/A'}\nClose rate: ${data.close_rate || 'N/A'}\nCurrent CRM: ${data.crm || 'N/A'}\nChallenge: ${data.challenge || 'N/A'}\nFollow-up process: ${data.followup_process || 'N/A'}\nFound us: ${data.found_us || 'N/A'}`;
      await hubspotClient.crm.notes.noteSimpleApi.create({
        properties: {
          hs_note_body: noteBody,
          hs_timestamp: new Date().toISOString()
        },
        associations: [{
          to: { id: result.body.id },
          types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 202 }]
        }]
      });
    }
    console.log('[' + new Date().toISOString() + '] HubSpot contact created:', result.body.id);
    return result;
  } catch (err) {
    // HubSpot free tier: if contact already exists (409), log and continue
    if (err.status === 409) {
      console.log('[' + new Date().toISOString() + '] HubSpot: contact already exists, skipping');
      return null;
    }
    console.log('[' + new Date().toISOString() + '] HubSpot error:', err.message || JSON.stringify(err.response?.body));
    return null;
  }
}
