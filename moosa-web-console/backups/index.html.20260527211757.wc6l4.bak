<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MOOSA</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#212121;color:#ececec;font-family:Arial,sans-serif;height:100vh;display:flex;flex-direction:column}
header{height:56px;border-bottom:1px solid #333;display:flex;align-items:center;padding:0 18px;font-size:18px;font-weight:bold;background:#171717}
#chat{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:18px}
.message-row{display:flex;width:100%}
.message-row.user{justify-content:flex-end}
.message-row.assistant{justify-content:flex-start}
.bubble{max-width:85%;padding:14px 16px;border-radius:18px;line-height:1.5;white-space:pre-wrap;word-wrap:break-word}
.user .bubble{background:#0b57d0;color:white}
.assistant .bubble{background:#303030;color:#ececec}
.copy-btn{margin-top:10px;font-size:12px;cursor:pointer;opacity:.7}
.copy-btn:hover{opacity:1}
pre{background:#111;border:1px solid #444;border-radius:10px;padding:12px;overflow-x:auto}
code{font-family:Consolas,monospace;font-size:13px}
#composer{border-top:1px solid #333;padding:14px;background:#171717;display:flex;gap:12px}
#token{display:none}
#message{flex:1;resize:none;border:none;outline:none;background:#2b2b2b;color:white;border-radius:12px;padding:14px;font-size:15px;min-height:52px;max-height:180px}
button{border:none;background:#0b57d0;color:white;padding:0 22px;border-radius:12px;cursor:pointer;font-size:15px}
button:hover{background:#1565d8}
#welcome{padding:20px;text-align:center;color:#aaa}
.typing{opacity:.75;font-style:italic}
.meta{font-size:11px;color:#9ca3af;margin-top:8px}
button:disabled{opacity:.5;cursor:not-allowed}
.dots::after{content:'';animation:dots 1.2s infinite}
@keyframes dots{0%{content:''}33%{content:'.'}66%{content:'..'}100%{content:'...'}}
@media(max-width:700px){.bubble{max-width:95%}header{font-size:16px}}
</style>
</head>
<body>
<header>MOOSA</header>
<div id="chat"><div id="welcome">MOOSA Web Console</div></div>
<div id="composer">
<input id="token" type="password" value="ChangeThisToAStrongPrivateToken-2026" />
<textarea id="message" placeholder="Message MOOSA..."></textarea>
<button id="sendBtn">Send</button>
</div>
<script>
const tokenEl=document.getElementById('token');
const messageEl=document.getElementById('message');
const sendBtn=document.getElementById('sendBtn');
const chatEl=document.getElementById('chat');

function scrollBottom(){chatEl.scrollTop=chatEl.scrollHeight;}


function escapeHtml(str){
  return String(str)
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;');
}

function renderMarkdown(text){
  let safe = escapeHtml(text);

  safe = safe.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
  safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  safe = safe.replace(/\n- /g, '<br>• ');
  safe = safe.replace(/\n/g, '<br>');

  return safe;
}

function createBubble(role,text,allowCopy=false){
  const ts=new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
  const row=document.createElement('div');
  row.className=`message-row ${role}`;
  const bubble=document.createElement('div');
  bubble.className='bubble';
  const body=document.createElement('div');
  
body.innerHTML = renderMarkdown(text);

  bubble.appendChild(body);
  const meta=document.createElement('div');
  meta.className='meta';
  meta.textContent=ts;
  bubble.appendChild(meta);

  if(allowCopy){
    const copy=document.createElement('div');
    copy.className='copy-btn';
    copy.textContent='Copy';
    copy.onclick=async()=>{
      await navigator.clipboard.writeText(text);
      copy.textContent='Copied';
      setTimeout(()=>copy.textContent='Copy',1200);
    };
    bubble.appendChild(copy);
  }
  row.appendChild(bubble);
  chatEl.appendChild(row);
  scrollBottom();
  return row;
}

async function sendMessage(){
  const text=messageEl.value.trim();
  if(!text)return;
  document.getElementById('welcome')?.remove();
  createBubble('user',text);
  messageEl.value='';
  sendBtn.disabled=true;
  const typingRow=createBubble('assistant','MOOSA is thinking');
  typingRow.querySelector('.bubble').classList.add('typing','dots');

  try{
    const res=await fetch('/api/chat',{
      method:'POST',
      headers:{'Content-Type':'application/json','Authorization':`Bearer ${tokenEl.value}`},
      body:JSON.stringify({message:text})
    });
    const data=await res.json();
    if(!data.taskId){
      sendBtn.disabled=false;
      typingRow.remove();
      createBubble('assistant',data.error||'Unknown error',true);
      return;
    }

    for(let i=0;i<60;i++){
      await new Promise(r=>setTimeout(r,2000));
      const taskRes=await fetch(`/api/task/${data.taskId}`,{
        headers:{'Authorization':`Bearer ${tokenEl.value}`}
      });
      const taskData=await taskRes.json();
      const task=taskData.task;
      if(!task)continue;

      if(task.status==='completed'){
        sendBtn.disabled=false;
        typingRow.remove();
        createBubble('assistant',task.output_json?.response||'[empty response]',true);
        return;
      }

      if(task.status==='failed'){
        sendBtn.disabled=false;
        typingRow.remove();
        createBubble('assistant',task.error_message||'Task failed',true);
        return;
      }
    }

    sendBtn.disabled=false;
    typingRow.remove();
    createBubble('assistant','Timed out waiting for MOOSA response.',true);
  }catch(err){
    typingRow.remove();
    createBubble('assistant','Request failed: '+err.message,true);
  }
}

sendBtn.onclick=sendMessage;
messageEl.addEventListener('input',()=>{
  messageEl.style.height='auto';
  messageEl.style.height=Math.min(messageEl.scrollHeight,180)+'px';
});

messageEl.addEventListener('keydown',e=>{
  if(e.key==='Enter'&&!e.shiftKey){
    e.preventDefault();
    sendMessage();
  }
});
scrollBottom();
</script>
</body>
</html>
