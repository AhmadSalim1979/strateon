<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>MOOSA</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#212121;color:#ececec;font-family:Arial,sans-serif;height:100vh;display:flex}
#sidebar{width:260px;background:#171717;border-right:1px solid #333;display:flex;flex-direction:column}
#sidebar-header{padding:14px;border-bottom:1px solid #333}
#newChatBtn{width:100%;height:34px}
#conversationList{flex:1;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:8px}
.conv-item{padding:11px;border-radius:10px;cursor:pointer;background:#222;display:flex;gap:8px;align-items:center}
.conv-item.active{background:#0b57d0}
.conv-title{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.rename-btn,.delete-btn,.pin-btn{background:transparent;padding:2px 6px;font-size:12px}
.delete-btn{color:#ff8a8a}
.pin-btn{color:#ffd166}
body.sidebar-collapsed #sidebar{display:none}
#main{flex:1;display:flex;flex-direction:column;height:100vh}
header{height:56px;border-bottom:1px solid #333;display:flex;align-items:center;padding:0 18px;font-size:18px;font-weight:bold;background:#171717}
#chat{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:18px}
.message-row{display:flex;width:100%}
.message-row.user{justify-content:flex-end}
.message-row.assistant{justify-content:flex-start}
.bubble{max-width:85%;padding:14px 16px;border-radius:18px;line-height:1.5;white-space:pre-wrap;word-wrap:break-word}
.user .bubble{background:#0b57d0;color:white}
.assistant .bubble{background:#303030;color:#ececec}
.copy-btn{margin-top:10px;font-size:12px;cursor:pointer;opacity:.7}
.copy-btn:hover{opacity:1}
.meta{font-size:11px;color:#9ca3af;margin-top:8px}
pre{background:#111;border:1px solid #444;border-radius:10px;padding:12px;overflow-x:auto}
code{font-family:Consolas,monospace;font-size:13px}
#composer{border-top:1px solid #333;padding:14px;background:#171717;display:flex;gap:12px}
#token{display:none}
#message{flex:1;resize:none;border:none;outline:none;background:#2b2b2b;color:white;border-radius:12px;padding:14px;font-size:15px;min-height:52px;max-height:180px}
button{border:none;background:#0b57d0;color:white;padding:0 18px;border-radius:12px;cursor:pointer;font-size:15px}
button:disabled{opacity:.5;cursor:not-allowed}
#welcome{text-align:center;color:#aaa;margin-top:40px}
.typing{opacity:.75;font-style:italic}
.dots::after{content:'';animation:dots 1.2s infinite}
@keyframes dots{0%{content:''}33%{content:'.'}66%{content:'..'}100%{content:'...'}}
@media(max-width:800px){
  #sidebar{
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    width:82%;
    max-width:320px;
    z-index:20;
    transform:translateX(-100%);
    transition:transform .22s ease;
    box-shadow:8px 0 24px rgba(0,0,0,.35);
  }

  body.mobile-sidebar-open #sidebar{
    transform:translateX(0);
  }

  body.sidebar-collapsed #sidebar{
    display:flex;
  }

  #main{
    width:100%;
  }

  .bubble{
    max-width:95%;
  }

  #composer{
    padding:10px;
  }

  #message{
    font-size:14px;
  }
}

#overlay{
  display:none;
}

@media(max-width:800px){
  body.mobile-sidebar-open #overlay{
    display:block;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.45);
    z-index:10;
  }
}
</style>
</head>
<body>
<div id="sidebar">
  <div id="sidebar-header">
  <button id="newChatBtn">+ New Chat</button>
  <input id="searchChats" placeholder="Search chats..." style="width:100%;margin-top:10px;padding:9px;border-radius:8px;border:none;background:#2b2b2b;color:white"/>
</div>
  <div id="conversationList"></div>
</div>

<div id="overlay"></div>

<div id="main">
<header>
  <button id="toggleSidebarBtn" style="margin-right:12px;padding:6px 10px">☰</button>
  MOOSA
  <button id="exportChatBtn" style="margin-left:auto;padding:6px 10px">Export</button>
</header>
<div id="chat"></div>
<div id="composer">
<input id="token" type="password" value="ChangeThisToAStrongPrivateToken-2026"/>
<textarea id="message" placeholder="Message MOOSA..."></textarea>
<button id="sendBtn">Send</button>
</div>
</div>

<script>
const STORAGE_KEY='moosa_console_conversations_v1';
let currentConversationId=null;

const chatEl=document.getElementById('chat');
const messageEl=document.getElementById('message');
const sendBtn=document.getElementById('sendBtn');
const tokenEl=document.getElementById('token');
const listEl=document.getElementById('conversationList');
const searchChatsEl=document.getElementById('searchChats');
const toggleSidebarBtn=document.getElementById('toggleSidebarBtn');
const overlayEl=document.getElementById('overlay');
const exportChatBtn=document.getElementById('exportChatBtn');

function getStore(){
  return JSON.parse(localStorage.getItem(STORAGE_KEY)||'{}');
}

function saveStore(store){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(store));
}

function scrollBottom(){
  chatEl.scrollTop=chatEl.scrollHeight;
}

function escapeHtml(str){
  return String(str)
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;');
}

function renderMarkdown(text){
  let safe=escapeHtml(text);
  safe=safe.replace(/```([\s\S]*?)```/g,'<pre><code>$1</code></pre>');
  safe=safe.replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>');
  safe=safe.replace(/\n- /g,'<br>• ');
  safe=safe.replace(/\n/g,'<br>');
  return safe;
}

function createConversation(title='New Chat'){
  const store=getStore();
  const id='conv_'+Date.now();
  store[id]={id,title,messages:[]};
  saveStore(store);
  currentConversationId=id;
  renderConversationList();
  loadConversation(id);
}

function renderConversationList(){
  const store=getStore();
  listEl.innerHTML='';

  const q=(searchChatsEl?.value||'').toLowerCase();

  Object.values(store)
    .filter(conv=>{
      const title=(conv.title||'').toLowerCase();
      const body=(conv.messages||[]).map(m=>m.text||'').join(' ').toLowerCase();
      return !q || title.includes(q) || body.includes(q);
    })
    .sort((a,b)=>{
      if(!!b.pinned !== !!a.pinned) return (b.pinned?1:0)-(a.pinned?1:0);
      return b.id.localeCompare(a.id);
    })
    .forEach(conv=>{
      const item=document.createElement('div');
      item.className='conv-item'+(conv.id===currentConversationId?' active':'');

      const title=document.createElement('div');
      title.className='conv-title';
      title.textContent=conv.title||'New Chat';

      const pin=document.createElement('button');
      pin.className='pin-btn';
      pin.textContent=conv.pinned?'★':'☆';
      pin.title=conv.pinned?'Unpin chat':'Pin chat';
      pin.onclick=(e)=>{
        e.stopPropagation();
        const store=getStore();
        if(store[conv.id]){
          store[conv.id].pinned=!store[conv.id].pinned;
          saveStore(store);
          renderConversationList();
        }
      };

      const rename=document.createElement('button');
      rename.className='rename-btn';
      rename.textContent='✎';
      rename.title='Rename chat';

      rename.onclick=(e)=>{
        e.stopPropagation();
        const next=prompt('Rename conversation:',conv.title||'New Chat');
        if(!next||!next.trim())return;

        const store=getStore();
        if(store[conv.id]){
          store[conv.id].title=next.trim().slice(0,60);
          saveStore(store);
          renderConversationList();
        }
      };

      item.onclick=()=>{
        currentConversationId=conv.id;
        renderConversationList();
        loadConversation(conv.id);
        document.body.classList.remove('mobile-sidebar-open');
      };

      const del=document.createElement('button');
      del.className='delete-btn';
      del.textContent='×';
      del.title='Delete chat';
      del.onclick=(e)=>{
        e.stopPropagation();
        if(!confirm('Delete this conversation?'))return;
        const store=getStore();
        delete store[conv.id];
        saveStore(store);
        const ids=Object.keys(store).sort();
        if(ids.length){
          currentConversationId=ids[ids.length-1];
          renderConversationList();
          loadConversation(currentConversationId);
        }else{
          createConversation();
        }
      };

      item.appendChild(title);
      item.appendChild(pin);
      item.appendChild(rename);
      item.appendChild(del);
      listEl.appendChild(item);
    });
}

function streamTextIntoBubble(row, text, onDone){
  const body=row.querySelector('.bubble > div');
  const words=String(text).split(/(\s+)/);
  let i=0;
  body.innerHTML='';

  const timer=setInterval(()=>{
    body.innerHTML=renderMarkdown(words.slice(0,i).join(''));
    i++;
    scrollBottom();

    if(i>words.length){
      clearInterval(timer);
      if(onDone)onDone();
    }
  },18);
}

function createBubble(role,text,allowCopy=false,persist=true){
  const ts=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});

  const row=document.createElement('div');
  row.className='message-row '+role;

  const bubble=document.createElement('div');
  bubble.className='bubble';

  const body=document.createElement('div');
  body.innerHTML=renderMarkdown(text);
  bubble.appendChild(body);

  const meta=document.createElement('div');
  meta.className='meta';
  meta.textContent=ts;
  bubble.appendChild(meta);

  if(allowCopy){
    const copy=document.createElement('div');
    copy.className='copy-btn';
    copy.textContent='Copy';
    copy.onclick=async()=>{
      await navigator.clipboard.writeText(text);
      copy.textContent='Copied';
      setTimeout(()=>copy.textContent='Copy',1200);
    };
    bubble.appendChild(copy);
  }

  row.appendChild(bubble);
  chatEl.appendChild(row);
  scrollBottom();

  if(persist)saveHistory();

  return row;
}

function saveHistory(){
  if(!currentConversationId)return;

  const store=getStore();
  if(!store[currentConversationId])return;

  const rows=[...chatEl.querySelectorAll('.message-row')].map(row=>{
    const role=row.classList.contains('user')?'user':'assistant';
    const body=row.querySelector('.bubble > div');
    return {role,text:body?.innerText||''};
  });

  store[currentConversationId].messages=rows;

  const firstUser=rows.find(r=>r.role==='user');
  if(firstUser && store[currentConversationId].title==='New Chat'){
    store[currentConversationId].title=
      firstUser.text.replace(/\s+/g,' ').trim().slice(0,50)||'New Chat';
  }

  saveStore(store);
  renderConversationList();
}

function loadConversation(id){
  const store=getStore();
  const conv=store[id];

  chatEl.innerHTML='';

  if(!conv||!conv.messages.length){
    chatEl.innerHTML='<div id="welcome">MOOSA Web Console</div>';
    return;
  }

  conv.messages.forEach(m=>{
    createBubble(m.role,m.text,m.role==='assistant',false);
  });

  scrollBottom();
}

async function sendMessage(){
  const text=messageEl.value.trim();
  if(!text)return;

  document.getElementById('welcome')?.remove();

  createBubble('user',text);

  messageEl.value='';
  sendBtn.disabled=true;

  const typingRow=createBubble('assistant','MOOSA is thinking',false,false);
  typingRow.querySelector('.bubble').classList.add('typing','dots');

  try{
    const res=await fetch('/api/chat',{
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'Authorization':`Bearer ${tokenEl.value}`
      },
      body:JSON.stringify({message:text})
    });

    const data=await res.json();

    if(!data.taskId){
      typingRow.remove();
      createBubble('assistant',data.error||'Unknown error',true);
      sendBtn.disabled=false;
      return;
    }

    for(let i=0;i<60;i++){
      await new Promise(r=>setTimeout(r,2000));

      const taskRes=await fetch('/api/task/'+data.taskId,{
        headers:{'Authorization':`Bearer ${tokenEl.value}`}
      });

      const taskData=await taskRes.json();
      const task=taskData.task;

      if(!task)continue;

      if(task.status==='completed'){
        typingRow.remove();
        const finalText=task.output_json?.response||'[empty response]';
        const row=createBubble('assistant','',false,false);
        streamTextIntoBubble(row, finalText, ()=>{
          row.remove();
          createBubble('assistant',finalText,true,true);
        });
        sendBtn.disabled=false;
        return;
      }

      if(task.status==='failed'){
        typingRow.remove();
        createBubble('assistant',task.error_message||'Task failed',true);
        sendBtn.disabled=false;
        return;
      }
    }

    typingRow.remove();
    createBubble('assistant','Timed out waiting for MOOSA response.',true);
    sendBtn.disabled=false;

  }catch(err){
    typingRow.remove();
    createBubble('assistant','Request failed: '+err.message,true);
    sendBtn.disabled=false;
  }
}

exportChatBtn.onclick=()=>{
  const store=getStore();
  const conv=store[currentConversationId];
  if(!conv)return;

  const lines=[
    'MOOSA Conversation Export',
    'Title: '+(conv.title||'New Chat'),
    'Exported: '+new Date().toISOString(),
    '',
    ...conv.messages.map(m=>`${m.role.toUpperCase()}: ${m.text}`)
  ];

  const blob=new Blob([lines.join('\n\n')],{type:'text/plain'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;
  a.download=(conv.title||'moosa-chat').replace(/[^a-z0-9-_]+/gi,'_').slice(0,50)+'.txt';
  a.click();
  URL.revokeObjectURL(url);
};

toggleSidebarBtn.onclick=()=>{
  if(window.innerWidth<=800){
    document.body.classList.toggle('mobile-sidebar-open');
  }else{
    document.body.classList.toggle('sidebar-collapsed');
  }
};

overlayEl.onclick=()=>{
  document.body.classList.remove('mobile-sidebar-open');
};

searchChatsEl.oninput=renderConversationList;

document.getElementById('newChatBtn').onclick=()=>{
  createConversation();
};

sendBtn.onclick=sendMessage;

messageEl.addEventListener('input',()=>{
  messageEl.style.height='auto';
  messageEl.style.height=Math.min(messageEl.scrollHeight,180)+'px';
});

messageEl.addEventListener('keydown',e=>{
  if(e.key==='Enter'&&!e.shiftKey){
    e.preventDefault();
    sendMessage();
  }
});

const initialStore=getStore();

if(Object.keys(initialStore).length===0){
  createConversation();
}else{
  currentConversationId=Object.keys(initialStore).sort().pop();
  renderConversationList();
  loadConversation(currentConversationId);
}

scrollBottom();
</script>
</body>
</html>